 "reviewStatus": "Scholarly review required before release. The source gives ayah references only: no Arabic Qur’an text, meanings or audio.",
 "editorialNote": "This document specifies ayah references (e.g., 2:285–286) and content requirements. The actual full Arabic verse text must be imported from a verified Uthmānī Qur’an dataset, not typed or generated by the developer.",
 "implementationDecision": "Build TWO distinct but connected experiences: (A) Hifz and Recitation Skills, where any Qur’anic verse may be learned; and (B) Masnūn Recitations, where an accurately sourced Hadith or established Prophetic practice determines the recommended occasion. Never confuse the two.",
 "proficiencyNote": "Proficiency must override age. A 12-year-old beginning Arabic should be able to start with the same supportive listen-and-repeat experience without childish labelling.",
 "masnunNote": "The citations above must be retained in the backend. Before launch, a qualified Hadith reviewer should confirm the translation and precise learning claim for each recitation, especially where grading is ḥasan or where juristic detail may differ.",
 "coverageNote": "Coverage rule: the 30 Juz boundaries describe the whole Qur’an. The selected ayah ranges are a curated CHILDREN’S curriculum, not every verse in the Juz. The entire Qur’an may be available for reading if a verified licensed dataset is integrated; only reviewed passages should appear as authored lessons.",
 "labels": [
  {
   "id": "M",
   "name": "Masnūn",
   "meaning": "Passage associated with an explicitly sourced authentic/accepted Hadith or Prophetic practice.",
   "rule": "Display context and citation, wording of claim reviewed before publication."
  },
  {
   "id": "H",
   "name": "Hifz elective",
   "meaning": "Qur’anic passage selected because it is useful, age-appropriate, or requested by families.",
   "rule": "Never display a specific reward, ritual time or special virtue without evidence."
  },
  {
   "id": "C",
   "name": "Curriculum passage",
   "meaning": "Verse selected to develop understanding, adab, Du’a language, and character.",
   "rule": "Teach as Qur’anic guidance; do not present as a prescribed daily recitation."
  }
 ],
 "experiences": [
  {
   "id": "picture",
   "name": "Picture & Audio",
   "users": "Approx. 4–6; beginner",
   "pacing": "2–5 minute listening, imitation and recognition; adult-operated recording."
  },
  {
   "id": "guided",
   "name": "Guided Reciter",
   "users": "Approx. 7–9; early reader",
   "pacing": "3–8 minute verse learning, repeat loops, short meaning and parent check."
  },
  {
   "id": "explorer",
   "name": "Independent Explorer",
   "users": "Approx. 10–13; developing reader",
   "pacing": "5–15 minute chunks, Tajweed prompts, delayed recall and reflection."
  }
 ],
 "steps": [
  {
   "name": "Hear it",
   "text": "Teacher-quality audio. Child can replay each ayah or a selected phrase without an arbitrary limit."
  },
  {
   "name": "See it",
   "text": "Display full Uthmānī verse, ayah number, optional word highlighting and Arabic text size settings."
  },
  {
   "name": "Say it",
   "text": "Repeat after the reciter with a pause; optional private recording. Do not score pronunciation as a binary pass/fail via unreliable ASR."
  },
  {
   "name": "Understand it",
   "text": "One or two plain-language sentences and a relatable example; separate the revealed meaning from imagined scenarios."
  },
  {
   "name": "Recall it",
   "text": "Hide text progressively, recover the next word or next ayah, and recite the full unit from memory."
  },
  {
   "name": "Keep it",
   "text": "Schedule future reviews. Ask “Would you like to practice again?” rather than penalizing missed days."
  }
 ],
 "modes": [
  {
   "name": "Listen only",
   "action": "Play complete ayah or short phrase with clear audio.",
   "use": "First exposure or relaxation."
  },
  {
   "name": "Echo",
   "action": "Playback, pause, child recites, optional replay.",
   "use": "New memorization."
  },
  {
   "name": "Loop × 3/5/10",
   "action": "Repeat one ayah or an approved chunk; child can stop anytime.",
   "use": "Controlled repetition."
  },
  {
   "name": "Reveal gradually",
   "action": "Hide one phrase, reveal after attempt.",
   "use": "Prompted recall."
  },
  {
   "name": "Verse bridge",
   "action": "Hear 1st verse, recite following verse unaided.",
   "use": "Order and continuity."
  },
  {
   "name": "Full passage",
   "action": "Child recites without visible text.",
   "use": "Independent assessment."
  },
  {
   "name": "Listen & compare",
   "action": "Side-by-side sample and self-recorded audio, only with consent.",
   "use": "Teacher/parent feedback."
  }
 ],
