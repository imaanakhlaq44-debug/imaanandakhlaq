# ========================================
# HOSTINGER .htaccess Configuration
# ========================================
# Copy this file to root of your Hostinger domain
# File Manager → Public HTML (.htaccess)
#
# This enables:
# - Gzip compression for PDFs/JS/CSS (50-60% size reduction)
# - Browser caching headers (faster repeat loads)
# - Security headers (protection)
# ========================================

# ========== GZIP COMPRESSION ==========
<IfModule mod_deflate.c>
  # Compress PDFs (IMPORTANT for books)
  AddOutputFilterByType DEFLATE application/pdf
  
  # Compress JavaScript
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  
  # Compress CSS
  AddOutputFilterByType DEFLATE text/css
  
  # Compress HTML
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  
  # Compress JSON APIs
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  
  # Set compression level
  DeflateCompressionLevel 9
</IfModule>

# ========== CACHING HEADERS ==========
<IfModule mod_headers.c>
  # Cache PDFs for 30 days (important!)
  <FilesMatch "\.pdf$">
    Header set Cache-Control "public, max-age=2592000, must-revalidate"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
  
  # Cache static assets for 1 year
  <FilesMatch "\.(jpg|jpeg|png|gif|ico|css|js|woff|woff2|ttf|otf|eot|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
  
  # Don't cache HTML (always check for updates)
  <FilesMatch "\.html?$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  
  # Security headers
  Header set X-UA-Compatible "IE=edge"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ========== EXPIRES CACHE ==========
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Default: 1 week for everything
  ExpiresDefault "access plus 1 week"
  
  # PDFs: 30 days
  ExpiresByType application/pdf A2592000
  
  # Static assets: 1 year
  ExpiresByType image/jpeg A31536000
  ExpiresByType image/gif A31536000
  ExpiresByType image/png A31536000
  ExpiresByType image/webp A31536000
  ExpiresByType text/css A31536000
  ExpiresByType text/javascript A31536000
  ExpiresByType application/javascript A31536000
  ExpiresByType application/x-font-ttf A31536000
  ExpiresByType application/x-font-woff A31536000
  ExpiresByType font/woff2 A31536000
  
  # HTML: 1 hour (always check for updates)
  ExpiresByType text/html A3600
  
  # JSON/API: 1 hour
  ExpiresByType application/json A3600
</IfModule>

# ========== GZIP ENCODING ==========
<IfModule mod_setenvif.c>
  <IfModule mod_headers.c>
    SetEnvIfNoCase ^(Accept-EncodXng|X-cept-Encoding|X{15}|~{15}|-{15})$ ^((gzip|deflate)\s*,?\s*)+|[X~-]{4,13}$ HAVE_Accept-Encoding
    RequestHeader append Accept-Encoding "gzip,deflate" env=HAVE_Accept-Encoding
  </IfModule>
</IfModule>

# ========== ENABLE MOD_REWRITE ==========
<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Remove .html extension
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([^\.]+)$ $1.html [NC,L]
</IfModule>

# ========== PREVENT HOTLINKING ==========
# (Optional) Prevent other sites from directly linking to your PDFs
# Uncomment if needed:
# <FilesMatch "\.pdf$">
#   SetEnvIf Referer "^https?://([^/]+\.)?yourdomain\.com" local_ref=1
#   Order Deny,Allow
#   Deny from all
#   Allow from env=local_ref
# </FilesMatch>

# ========== MIME TYPES ==========
<IfModule mod_mime.c>
  AddType application/javascript js
  AddType application/x-javascript jsx
  AddType text/css css
  AddType image/svg+xml svg svgz
  AddEncoding gzip svgz
  
  # Font MIME types
  AddType application/vnd.ms-fontobject eot
  AddType application/x-font-ttf ttf ttc
  AddType application/x-font-woff woff
  AddType font/woff2 woff2
  AddType image/webp webp
</IfModule>

# ========== ERROR PAGES ==========
# (Optional) Custom error pages
# ErrorDocument 404 /404.html
# ErrorDocument 500 /500.html

# ========== SECURITY ==========
# Disable directory listing
Options -Indexes

# Protect sensitive files
<FilesMatch "(\.env|\.git|\.gitignore|package\.json|composer\.json)">
  Order allow,deny
  Deny from all
</FilesMatch>

# ========== OPTIMIZE IMAGES ==========
# (Optional) If using mod_pagespeed or similar
# <IfModule mod_pagespeed.c>
#   ModPagespeed on
#   ModPagespeedEnableFilters rewrite_images
#   ModPagespeedEnableFilters compress_pdf
# </IfModule>

# ========== END OF CONFIGURATION ==========
# Questions? See: HOSTINGER_PDF_OPTIMIZATION.md
