rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------

    // The signed-in user's own /users doc (their role, school_id, links).
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isSuper() {
      return signedIn() && me().role == 'super_admin';
    }

    // Teachers and school admins ("staff") act only inside their own school.
    function isStaff() {
      return signedIn() && me().role in ['teacher', 'school_admin'];
    }

    function mySchool() {
      return me().school_id;
    }

    // Does the target doc belong to the caller's school?
    // Requires the caller to actually HAVE a school (blocks empty-string match).
    function sameSchool(data) {
      return mySchool() is string && mySchool() != '' && data.school_id == mySchool();
    }

    function onlyKeys(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------------------------------------------------------------
    // Family accounts
    // ---------------------------------------------------------------
    // A family signs in once (a /users doc with role 'family') and its
    // children have no login of their own. Every doc a child owns carries
    // family_uid, denormalized exactly the way school_id already is, so
    // ownership costs no extra document read and survives inside `list`.
    //
    // These branches are ADDITIVE. Legacy students still sign in as
    // themselves and their documents have no family_uid at all, so every
    // student_uid branch below stays until the cutover. get(field, '') is
    // what makes that safe: a missing family_uid reads as '' and simply
    // fails this check instead of erroring out the whole rule.
    function isMyFamily(data) {
      return signedIn() && data.get('family_uid', '') == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // 1. Invites
    // ---------------------------------------------------------------
    // The code itself is the secret: a single doc may be fetched by anyone
    // who knows its exact code (needed pre-auth during registration), but
    // the collection can never be listed/enumerated by outsiders.
    match /invites/{code} {
      allow get: if true;
      allow list: if isSuper() || (isStaff() && sameSchool(resource.data));

      // Staff create invites only for their own school, only for member roles.
      allow create: if isSuper() || (
        isStaff() &&
        request.resource.data.school_id == mySchool() &&
        request.resource.data.role in ['teacher', 'student'] &&
        request.resource.data.status == 'pending'
      );

      // Either: a newly registered user marks THEIR code as used (status flip
      // only, recording their own uid), or staff manage their school's codes.
      allow update: if isSuper() || (
        signedIn() &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'used' &&
        request.resource.data.used_by_uid == request.auth.uid &&
        onlyKeys(['status', 'used_by_uid', 'used_at'])
      ) || (
        isStaff() && sameSchool(resource.data)
      );

      allow delete: if isSuper() ||
        (signedIn() && me().role == 'school_admin' && sameSchool(resource.data));
    }

    // ---------------------------------------------------------------
    // 2. Schools
    // ---------------------------------------------------------------
    match /schools/{schoolId} {
      allow read: if signedIn();

      // A school doc may only be created by the school_admin user whose own
      // profile points at this exact school id, claiming himself as admin.
      // (The /users create rule below guarantees that profile could only be
      // created while this school id was still unused.)
      allow create: if signedIn() &&
        request.resource.data.admin_uid == request.auth.uid &&
        me().role == 'school_admin' &&
        mySchool() == schoolId;

      allow update: if isSuper() ||
        (signedIn() && me().role == 'school_admin' && resource.data.admin_uid == request.auth.uid);

      allow delete: if isSuper();
    }

    // ---------------------------------------------------------------
    // 3. Users (students, teachers, parents, school admins, individuals)
    // ---------------------------------------------------------------
    match /users/{userId} {
      // Self, super admin, or same-school staff. No public reads: phone-to-email
      // login lookup goes through the lookupEmailByPhone Cloud Function instead.
      // Queries from dashboards must filter on school_id so list evaluation
      // stays provable.
      //
      // The 'parent' role is retired and never coming back. Its replacement is
      // 'family': a school-provisioned login whose children are ordinary
      // student docs carrying family_uid. A family reaches its own children
      // and nobody else's — there is still no branch that hands one account
      // access to an unrelated user's doc.
      allow get, list: if signedIn() && (
        request.auth.uid == userId ||
        // A family reads its own children. Dashboard queries must filter on
        // family_uid for list evaluation to stay provable, the same way staff
        // queries filter on school_id.
        isMyFamily(resource.data) ||
        isSuper() ||
        (me().role in ['teacher', 'school_admin'] && sameSchool(resource.data))
      );

      // Signup. The role is locked to what the flow legitimately allows:
      //  - individual: open trial signup, never attached to a school
      //  - school_admin: only while claiming a school id that does not exist
      //    yet (the school doc is created right after, owned by this uid)
      //  - teacher/student/parent: must present a pending invite whose role
      //    and school match the profile being created
      // 'super_admin' can never be self-assigned (set it via Admin SDK /
      // Firebase console only).
      allow create: if signedIn() && request.auth.uid == userId && (
        (
          request.resource.data.role == 'individual' &&
          !('school_id' in request.resource.data) &&
          // trial_end is stamped server-side by the setTrialOnSignup function.
          !('trial_end' in request.resource.data)
        ) || (
          request.resource.data.role == 'school_admin' &&
          request.resource.data.school_id is string &&
          request.resource.data.school_id != '' &&
          !exists(/databases/$(database)/documents/schools/$(request.resource.data.school_id))
        ) || (
          request.resource.data.role in ['teacher', 'student'] &&
          request.resource.data.invitation_code is string &&
          get(/databases/$(database)/documents/invites/$(request.resource.data.invitation_code)).data.role == request.resource.data.role &&
          get(/databases/$(database)/documents/invites/$(request.resource.data.invitation_code)).data.status == 'pending' &&
          request.resource.data.school_id == get(/databases/$(database)/documents/invites/$(request.resource.data.invitation_code)).data.school_id
        )
      );

      // Updates are field-whitelisted per actor. role / school_id /
      // invitation_code / trial_end can never be changed from the client
      // (except the one-off school_id backfill below).
      allow update: if isSuper() || (
        // Self: profile fields + own game progress + parent's student link.
        //
        // parentGate holds the family's 4-digit PIN (hashed) for the Parent
        // Area on the student dashboard. It has to be writable here because
        // the family shares one account and sets the PIN from that session —
        // without it, setup failed with permission-denied. Note this is a UI
        // gate, not a security boundary: the PIN hash lives in the child's own
        // doc, so a determined child can read or overwrite it. It keeps the
        // parent section out of casual reach, nothing more.
        request.auth.uid == userId &&
        onlyKeys(['name', 'phone', 'email', 'photoURL', 'game_state',
                  'linked_student_code', 'linked_student_uid', 'parentGate'])
      ) || (
        // A family editing one of its own children: the same profile and
        // progress fields that child could change for itself, minus the
        // account-level ones. parentGate is deliberately absent — the PIN
        // lives on the family doc, which the self branch above covers.
        //
        // family_uid is in no whitelist anywhere, so a client can neither set
        // it nor move a child to another family. Only the Admin SDK can.
        isMyFamily(resource.data) &&
        onlyKeys(['name', 'photoURL', 'game_state'])
      ) || (
        // Teacher: approve/adjust a same-school student's game progress.
        signedIn() && me().role == 'teacher' &&
        sameSchool(resource.data) &&
        onlyKeys(['game_state'])
      ) || (
        // Teacher repair tool: attach an orphaned profile (no school yet)
        // to the teacher's own school — never to someone else's.
        signedIn() && me().role == 'teacher' &&
        !('school_id' in resource.data) &&
        request.resource.data.school_id == mySchool() &&
        onlyKeys(['school_id'])
      ) || (
        // School admin: edit same-school member profiles.
        signedIn() && me().role == 'school_admin' &&
        sameSchool(resource.data) &&
        onlyKeys(['name', 'class_id', 'photoURL'])
      );
      // The parent branch that marked chapters approved on a linked child is
      // gone with the role: work goes straight from the student to the teacher.

      allow delete: if isSuper() ||
        (signedIn() && me().role == 'school_admin' && sameSchool(resource.data));
    }

    // ---------------------------------------------------------------
    // 4. Activity Submissions
    // ---------------------------------------------------------------
    match /activity_submissions/{subId} {
      // The owning student reads their own sheets — that is also what feeds
      // the Parent Area's chapter list, since the family shares that account.
      allow get, list: if signedIn() && (
        resource.data.student_uid == request.auth.uid ||
        isMyFamily(resource.data) ||
        isSuper() ||
        (isStaff() && sameSchool(resource.data))
      );

      // Students submit their own work only — or the family that owns them.
      allow create: if signedIn() && (
        request.resource.data.student_uid == request.auth.uid ||
        isMyFamily(request.resource.data)
      );

      allow update: if isSuper() || (
        isStaff() && sameSchool(resource.data)
      ) || (
        // The owning student, while the work is still open. The weekly
        // activity is filled in over several days and every autosave (plus the
        // final "Submit for Review") rewrites this SAME doc id, so the first
        // write is a create and every one after it is an update. Without this
        // branch the student could only ever save once: every later save —
        // including the final submit — failed with permission-denied, which
        // surfaced as "There was an error saving your progress."
        signedIn() &&
        // Ownership, by either route, and the doc may not change hands
        // mid-update: both the existing and the incoming version have to
        // point at the same caller.
        (
          (resource.data.student_uid == request.auth.uid &&
           request.resource.data.student_uid == request.auth.uid) ||
          (isMyFamily(resource.data) && isMyFamily(request.resource.data))
        ) &&
        // Never let a student rewrite work a teacher has already signed off.
        // A sheet the teacher sent back carries 'needs_redo', which passes this
        // check on purpose — redoing it is the whole point.
        resource.data.get('reviewStatus', '') != 'teacher_approved' &&
        // Only self-study "individual" accounts may mark their own work
        // approved; a school student's sheet is the teacher's call.
        (request.resource.data.get('reviewStatus', '') != 'teacher_approved' ||
         me().role == 'individual')
      );
      // The parent approval branch is gone with the role.

      allow delete: if isSuper() || (isStaff() && sameSchool(resource.data));
    }

    // ---------------------------------------------------------------
    // 5. Activity Drafts (per-day autosave scratch space)
    // ---------------------------------------------------------------
    // Private working copies a student saves while filling the week in; only
    // the owner ever reads or writes them. This collection previously had NO
    // rule at all, so every draft save was denied by default.
    match /activity_drafts/{draftId} {
      allow get, list: if signedIn() && (
        resource.data.student_uid == request.auth.uid ||
        isMyFamily(resource.data)
      );

      allow create: if signedIn() && (
        request.resource.data.student_uid == request.auth.uid ||
        isMyFamily(request.resource.data)
      );

      allow update: if signedIn() && (
        (resource.data.student_uid == request.auth.uid &&
         request.resource.data.student_uid == request.auth.uid) ||
        (isMyFamily(resource.data) && isMyFamily(request.resource.data))
      );

      allow delete: if isSuper() || (signedIn() && (
        resource.data.student_uid == request.auth.uid ||
        isMyFamily(resource.data)
      ));
    }

    // ---------------------------------------------------------------
    // 6. Activity Attendance Sessions
    // ---------------------------------------------------------------
    match /activity_attendance/{sessionId} {
      allow get, list: if signedIn() && (
        resource.data.student_uid == request.auth.uid ||
        isMyFamily(resource.data) ||
        isSuper() ||
        (isStaff() && sameSchool(resource.data))
      );

      // The page writes this with setDoc({ merge: true }), so the first call
      // of a session is a create and every later one an update — both need
      // the family branch or attendance silently stops recording.
      allow create: if signedIn() && (
        request.resource.data.student_uid == request.auth.uid ||
        isMyFamily(request.resource.data)
      );

      allow update: if signedIn() && (
        (resource.data.student_uid == request.auth.uid &&
         request.resource.data.student_uid == request.auth.uid) ||
        (isMyFamily(resource.data) && isMyFamily(request.resource.data))
      );
    }

    // ---------------------------------------------------------------
    // 7. Public Scores (leaderboard mirror)
    // ---------------------------------------------------------------
    // Name, avatar, role, school name and points — nothing else. The
    // mirrorPublicScore Cloud Function is the only writer (the Admin SDK
    // bypasses these rules), so the client can never forge a ranking.
    // This exists because the leaderboard needs a cross-school read that
    // /users must never allow: a user doc also carries phone, email and
    // invitation_code.
    match /public_scores/{userId} {
      allow get, list: if signedIn();
      allow write: if false;
    }
  }
}
