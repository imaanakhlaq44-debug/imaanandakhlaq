rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to get the current logged-in user's data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // 1. Invites Collection
    // Reading is open so users can validate their invitation codes during registration.
    // Only school_admin and teacher roles can create new invite codes.
    // Only authenticated users can update an invite (to mark it as 'used' during registration).
    // Only school_admin can delete invite codes.
    match /invites/{code} {
      allow read: if true;
      allow create: if request.auth != null && getUserData().role in ['school_admin', 'teacher'];
      allow update: if request.auth != null && (
        // Allow marking as 'used' during registration (status change only)
        (request.resource.data.status == 'used' && resource.data.status == 'pending') ||
        // Allow admins/teachers to manage invites
        getUserData().role in ['school_admin', 'teacher']
      );
      allow delete: if request.auth != null && getUserData().role == 'school_admin';
    }

    // 2. Schools Collection
    // Only registered users can see school profiles.
    match /schools/{schoolId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && getUserData().role == 'school_admin';
    }

    // 3. Activity Submissions
    match /activity_submissions/{subId} {
      // Students can read their own. Teachers/Admins can read for their school. Parents can read to review.
      allow read: if request.auth != null && (
        resource.data.student_uid == request.auth.uid || 
        resource.data.school_id == getUserData().school_id ||
        getUserData().role in ['parent', 'teacher', 'school_admin']
      );
      // Students can submit activities for themselves.
      allow create: if request.auth != null && request.resource.data.student_uid == request.auth.uid;
      // Parents & Teachers can update submissions (to add teacher approval or parent notes).
      allow update: if request.auth != null && getUserData().role in ['teacher', 'parent', 'school_admin'];
      // Teachers can delete rejected submissions.
      allow delete: if request.auth != null && getUserData().role == 'teacher';
    }

    // 3b. Activity Attendance Sessions
    match /activity_attendance/{sessionId} {
      allow read: if request.auth != null && (
        resource.data.student_uid == request.auth.uid ||
        (
          getUserData().role in ['teacher', 'school_admin'] &&
          resource.data.school_id == getUserData().school_id
        )
      );

      allow create: if request.auth != null && request.resource.data.student_uid == request.auth.uid;

      allow update: if request.auth != null &&
        resource.data.student_uid == request.auth.uid &&
        request.resource.data.student_uid == request.auth.uid;
    }

    // 4. Users Collection (Includes Students, Teachers, Parents)
    match /users/{userId} {
      // Public reads allowed so phone-to-email login lookup works from any device
      // (even before the user is authenticated). User docs contain only profile data.
      allow read: if true;
      
      // Creating accounts requires auth (handled by Firebase Auth).
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Updates: A user can update themselves. Teachers and Parents can update students (to add points / approvals).
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        getUserData().role in ['teacher', 'parent', 'school_admin']
      );

      // School admins can delete users from their school.
      allow delete: if request.auth != null && getUserData().role == 'school_admin';
    }
  }
}
